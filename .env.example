# --- App ---
APP_PASSWORD=change-me
SECRET_KEY=generate-with-python-secrets-token_urlsafe-32
LOG_LEVEL=INFO
PORT=2009
DATABASE_URL=sqlite:///./data/domcity.db

# --- Encryption (Fernet) ---
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- PushPress ---
# Your gym's tenant subdomain, e.g. https://yourgym.members.pushpress.com
# If your gym uses the root domain, set: https://members.pushpress.com
PUSHPRESS_BASE_URL=https://members.pushpress.com
PUSHPRESS_EMAIL=
PUSHPRESS_PASSWORD=

# Booking window in hours before class start (PushPress default is 24, priority members 48)
BOOKING_WINDOW_HOURS=24

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Timezone ---
TZ=Europe/Amsterdam
