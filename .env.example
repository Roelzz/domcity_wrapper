# --- App ---
# These same credentials gate the web login AND the MCP OAuth login screen.
APP_USERNAME=admin
APP_PASSWORD=change-me
SECRET_KEY=generate-with-python-secrets-token_urlsafe-32
LOG_LEVEL=INFO
PORT=2009
DATABASE_URL=sqlite:///./data/domcity.db

# --- MCP server ---
# Public base URL of this app = the OAuth issuer for the MCP endpoint at /mcp.
# Local dev: http://localhost:2009. Production: the exact public HTTPS domain
# (must match what Claude connects to, e.g. https://domcity.example.com).
MCP_BASE_URL=http://localhost:2009

# --- Encryption (Fernet) ---
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- PushPress ---
# The app logs into PushPress on startup with these credentials, caches the
# JWT in SQLite, and refreshes daily once the cached token is within 7 days
# of expiry. No manual token rotation.
PUSHPRESS_EMAIL=
PUSHPRESS_PASSWORD=

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Timezone ---
TZ=Europe/Amsterdam
