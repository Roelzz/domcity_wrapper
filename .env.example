# --- App ---
APP_PASSWORD=change-me
SECRET_KEY=generate-with-python-secrets-token_urlsafe-32
LOG_LEVEL=INFO
PORT=2009
DATABASE_URL=sqlite:///./data/domcity.db

# --- Encryption (Fernet) ---
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- PushPress ---
# The app logs into PushPress on startup with these credentials, caches the
# JWT in SQLite, and refreshes daily once the cached token is within 7 days
# of expiry. No manual token rotation.
PUSHPRESS_EMAIL=
PUSHPRESS_PASSWORD=

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Timezone ---
TZ=Europe/Amsterdam
