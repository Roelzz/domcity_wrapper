# --- App ---
APP_PASSWORD=change-me
SECRET_KEY=generate-with-python-secrets-token_urlsafe-32
LOG_LEVEL=INFO
PORT=2009
DATABASE_URL=sqlite:///./data/domcity.db

# --- Encryption (Fernet) ---
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- PushPress ---
# Bearer JWT, valid ~60 days. How to obtain:
#   1. Log into https://members.pushpress.com in Chrome/Edge.
#   2. Open DevTools -> Network -> click any /graphql request.
#   3. In the Headers tab, copy the value of "authorization" (the long token
#      after "Bearer ").
#   4. Paste it here, WITHOUT the "Bearer " prefix.
# When it expires (the app will warn you a week before), repeat.
PUSHPRESS_TOKEN=

# Default booking window for new automation rules (hours before class).
# This CrossFit gym opens its window 14 days (336h) ahead.
DEFAULT_LEAD_TIME_HOURS=336

# --- Telegram notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Timezone ---
TZ=Europe/Amsterdam
